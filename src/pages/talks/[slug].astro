---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { toSlug } from '../../utils/slug';
import { toEmbedSrc } from '../../utils/slides';

export async function getStaticPaths() {
  const posts = await getCollection('talks');
  return posts.map(post => ({
    params: { slug: toSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const { title, date, description, tags, event, slides, video, github, live, slideshare, slidesFile, registration } = post.data;

const hasGoogleSlides = Boolean(slides && slides.includes('docs.google.com/presentation'));
const embedSrc = slides ? toEmbedSrc(slides) : null;

const isPast = new Date(date).getTime() < new Date(new Date().toISOString().slice(0, 10)).getTime();
const registrationClosed = isPast;
---

<PostLayout title={title} date={date} description={description} tags={tags} body={post.body} backHref="/talks/" backLabel="Talks">
  {event && (
    <div class="talk-event stagger-item">
      <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
        <line x1="16" y1="2" x2="16" y2="6"/>
        <line x1="8" y1="2" x2="8" y2="6"/>
        <line x1="3" y1="10" x2="21" y2="10"/>
      </svg>
      <span>{event}</span>
    </div>
  )}

  {hasGoogleSlides && embedSrc && (
    <div class="slides-primary stagger-item">
      <div class="embed-wrapper">
        <iframe
          src={embedSrc}
          frameborder="0"
          allowfullscreen
          loading="lazy"
          title={`Presentation slides for ${title}`}
        />
      </div>
      <div class="slides-actions">
        <a href={slides} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
          <span>Open in Google Slides</span>
        </a>
      </div>
    </div>
  )}

  <Content />

  <div class="talk-resources stagger-item">
    <div class="resource-links">
      {registration && (
        registrationClosed ? (
          <span class="resource-link resource-link--small resource-link--disabled" aria-disabled="true" title="Registration closed — this event has ended">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Registration Closed</span>
          </span>
        ) : (
          <a href={registration} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
              <line x1="16" y1="2" x2="16" y2="6"/>
              <line x1="8" y1="2" x2="8" y2="6"/>
              <line x1="3" y1="10" x2="21" y2="10"/>
            </svg>
            <span>Register</span>
          </a>
        )
      )}
      {slidesFile && (
        <a href={`/talks/${slidesFile}`} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span>Download Slides (PDF)</span>
        </a>
      )}
      {video && (
        <a href={video} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <polygon points="23 7 16 12 23 17 23 7"/>
            <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
          </svg>
          <span>Watch Video</span>
        </a>
      )}
      {github && (
        <a href={github} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
          </svg>
          <span>Source Code</span>
        </a>
      )}
      {live && (
        <a href={live} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/>
            <line x1="2" y1="12" x2="22" y2="12"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span>Live Demo</span>
        </a>
      )}
      {slideshare && (
        <a href={slideshare} target="_blank" rel="noopener noreferrer" class="resource-link resource-link--small">
          <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/>
            <line x1="16" y1="17" x2="8" y2="17"/>
            <polyline points="10 9 9 9 8 9"/>
          </svg>
          <span>SlideShare</span>
        </a>
      )}
    </div>
  </div>
</PostLayout>

<style is:global>
  .talk-event {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.875rem;
    margin-bottom: 1.5rem;
    background: var(--muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-3);
    color: var(--text-light);
    font-size: var(--text-1);
    font-weight: 500;
  }

  .talk-event .icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    opacity: 0.7;
  }

  .slides-primary {
    margin-bottom: 2rem;
    border-radius: var(--radius-3);
    overflow: hidden;
    background: var(--card-bg);
    border: 1px solid var(--border);
  }

  .slides-primary .embed-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
  }

  .slides-primary .embed-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  .slides-actions {
    padding: 0.625rem 0.75rem;
    border-top: 1px solid var(--border);
    background: var(--muted);
    display: flex;
    justify-content: flex-start;
  }

  .talk-resources {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .resource-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .resource-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: var(--radius-3);
    color: var(--text);
    text-decoration: none;
    font-size: var(--text-1);
    transition: all var(--transition-fast);
  }

  .resource-link--small {
    padding: 0.375rem 0.625rem;
    font-size: 0.8125rem;
    gap: 0.35rem;
    border-radius: var(--radius-2);
    line-height: 1.2;
  }

  .resource-link--small .icon {
    width: 14px;
    height: 14px;
  }

  .resource-link--disabled {
    opacity: 0.6;
    cursor: not-allowed;
    pointer-events: none;
    background: var(--muted);
  }

  .resource-link:hover {
    border-color: var(--primary);
    color: var(--primary);
    transform: translateY(-2px);
    box-shadow: var(--shadow-2);
  }

  .resource-link--disabled:hover {
    transform: none;
    box-shadow: none;
    border-color: var(--border);
    color: var(--text);
  }

  .resource-link .icon {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }
</style>