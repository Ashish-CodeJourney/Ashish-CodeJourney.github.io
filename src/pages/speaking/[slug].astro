---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../site.config';
import { toSlug } from '../../utils/slug';
import { formatDate } from '../../utils/date';
import { toEmbedSrc } from '../../utils/slides';
import { inviteMailto, isPastEvent } from '../../utils/speaking.js';

export async function getStaticPaths() {
  const talks = await getCollection('talks');
  return talks.map((talk) => ({ params: { slug: toSlug(talk.id) }, props: { talk } }));
}

const { talk } = Astro.props;
const { Content } = await render(talk);
const { title, date, event, description, tags, banner, slides, slidesFile, video, github, live, slideshare, registration } = talk.data;

const embedSrc = slides ? toEmbedSrc(slides) : null;
const isPast = isPastEvent({ date, today: new Date() });

const resources = [
  { href: slidesFile ? `/talks/${slidesFile}` : undefined, label: 'Download the slides (PDF)' },
  { href: slides && !embedSrc ? slides : undefined, label: 'Open the slides' },
  { href: video, label: 'Watch the recording' },
  { href: github, label: 'Source code on GitHub' },
  { href: live, label: 'Try the live demo' },
  { href: slideshare, label: 'Slides on SlideShare' },
].filter((resource): resource is { href: string; label: string } => Boolean(resource.href));

const invite = inviteMailto({ email: SITE.email, subject: `Speaking invitation: ${title}` });
---

<BaseLayout title={title} description={description ?? `${title}, a talk by ${SITE.author} at ${event}.`}>
  <article class="wrap talk">
    <header class="page-head">
      <a class="back" href="/speaking/">All talks</a>
      <h1>{title}</h1>
      <p class="where">Given at {event} on <time datetime={date}>{formatDate(date)}</time></p>
      {description && <p class="summary">{description}</p>}
      {registration && (
        isPast
          ? <p class="registration">Registration closed. This event has ended.</p>
          : <p class="registration"><a class="cta" href={registration} target="_blank" rel="noopener noreferrer">Register for this talk</a></p>
      )}
    </header>

    {embedSrc && (
      <figure class="slides">
        <div class="frame">
          <iframe src={embedSrc} allowfullscreen loading="lazy" title={`Slides for ${title}`}></iframe>
        </div>
        <figcaption><a href={slides} target="_blank" rel="noopener noreferrer">Open the slides in Google Slides</a></figcaption>
      </figure>
    )}

    {!embedSrc && banner && (
      <img class="banner" src={banner} alt="" width="1280" height="720" loading="eager" decoding="async" />
    )}

    <div class="prose">
      <Content />
    </div>

    {resources.length > 0 && (
      <section class="resources" aria-labelledby="resources">
        <h2 id="resources">Slides, code and recordings</h2>
        <ul class="rows">
          {resources.map((resource) => (
            <li><a href={resource.href} target="_blank" rel="noopener noreferrer">{resource.label}</a></li>
          ))}
        </ul>
      </section>
    )}

    {tags.length > 0 && (
      <p class="tags">Topics: {tags.join(', ')}</p>
    )}

    <p class="again">Want this talk at your event? <a href={invite}>Invite me to speak</a>.</p>
  </article>
</BaseLayout>

<style>
  .talk { padding-bottom: var(--space-8); }
  .back { display: inline-block; margin-bottom: var(--space-5); font-weight: 600; }
  .page-head h1 { max-width: 22ch; }
  .page-head .where { color: var(--ink-2); font-size: var(--step-0); }
  .page-head .summary { color: var(--ink); }
  .registration { font-size: var(--step-0); }
  .cta {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius);
    background: var(--lamp);
    color: var(--bg);
    font-weight: 600;
    text-decoration: none;
  }
  .cta:hover { background: var(--ink); }

  .slides { margin-bottom: var(--space-7); max-width: 56rem; }
  .frame { position: relative; aspect-ratio: 16 / 9; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface); }
  .frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .slides figcaption { margin-top: var(--space-3); font-size: var(--step--1); }
  .banner { max-width: 56rem; width: 100%; border-radius: var(--radius); margin-bottom: var(--space-7); }

  .resources { margin-top: var(--space-7); max-width: var(--measure-tech); }
  .resources h2 { margin-bottom: var(--space-4); }
  .resources li a { display: block; padding-block: var(--space-3); font-weight: 600; }

  .tags, .again { max-width: var(--measure-tech); margin-top: var(--space-6); color: var(--ink-2); }
  .tags { font-size: var(--step--1); }
</style>
