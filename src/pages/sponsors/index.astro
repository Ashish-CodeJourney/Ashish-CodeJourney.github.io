---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRows from '../../components/PostRows.astro';
import { SITE } from '../../site.config';
import { toSlug } from '../../utils/slug';

const sponsors = [...(await getCollection('sponsors'))].sort((a, b) => b.data.date.localeCompare(a.data.date));
const featured = sponsors.find((sponsor) => sponsor.data.current);
const FeaturedContent = featured ? (await render(featured)).Content : undefined;

const rows = sponsors.map((sponsor) => ({
  href: `/sponsors/${toSlug(sponsor.id)}/`,
  title: sponsor.data.current ? `${sponsor.data.name} (current)` : sponsor.data.name,
  date: sponsor.data.date,
  summary: sponsor.data.description,
}));
---

<BaseLayout title="Sponsors" description="People and organisations who have sponsored me to attend conferences and other events.">
  <div class="wrap sponsors">
    <header class="page-head">
      <h1>Sponsors</h1>
      <p>The people and organisations whose support lets me travel to conferences, learn in the room, and bring what I learn back to the community. Thank you.</p>
    </header>

    {featured && FeaturedContent && (
      <section class="featured" aria-labelledby="featured">
        <h2 id="featured">Currently supported by <a href={`/sponsors/${toSlug(featured.id)}/`}>{featured.data.name}</a></h2>
        <div class="prose"><FeaturedContent /></div>
      </section>
    )}

    <section aria-labelledby="timeline">
      <h2 id="timeline">Every sponsorship</h2>
      {rows.length === 0
        ? <p class="empty">No sponsors yet.</p>
        : <PostRows items={rows} />}
    </section>

    <p class="ask">Want to help me get to the next event? <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Sponsoring you')}`}>Write to me</a>.</p>
  </div>
</BaseLayout>

<style>
  .sponsors { padding-bottom: var(--space-8); }
  h2 { margin-bottom: var(--space-4); }
  .featured { margin-bottom: var(--space-7); padding-left: var(--space-5); border-left: 2px solid var(--lamp-glow); }
  .empty { color: var(--ink-2); }
  .ask { margin-top: var(--space-7); color: var(--ink-2); max-width: var(--measure-tech); }
</style>
