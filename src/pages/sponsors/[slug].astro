---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate } from '../../utils/date';
import { toSlug } from '../../utils/slug';

export async function getStaticPaths() {
  const sponsors = await getCollection('sponsors');
  return sponsors.map((sponsor) => ({ params: { slug: toSlug(sponsor.id) }, props: { sponsor } }));
}

const { sponsor } = Astro.props;
const { Content } = await render(sponsor);
const { name, date, current, description, url, logo, linkedin, x } = sponsor.data;

const links = [
  { href: url, label: `${name} website` },
  { href: linkedin, label: `${name} on LinkedIn` },
  { href: x, label: `${name} on X` },
].filter((link): link is { href: string; label: string } => Boolean(link.href));
---

<BaseLayout title={name} description={description ?? `About ${name}'s sponsorship.`}>
  <article class="wrap sponsor">
    <header class="page-head">
      <a class="back" href="/sponsors/">All sponsors</a>
      <h1>{name}</h1>
      <p>{current ? 'Currently sponsoring me, since' : 'Sponsored me on'} <time datetime={date}>{formatDate(date)}</time>.</p>
      {description && <p class="summary">{description}</p>}
    </header>

    {logo && (
      <div class="logo">
        <img src={logo} alt={`${name} logo`} width="240" height="80" loading="eager" decoding="async" />
      </div>
    )}

    <div class="prose"><Content /></div>

    {links.length > 0 && (
      <ul class="rows links">
        {links.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
      </ul>
    )}
  </article>
</BaseLayout>

<style>
  .sponsor { padding-bottom: var(--space-8); }
  .back { display: inline-block; margin-bottom: var(--space-5); font-weight: 600; }
  .page-head .summary { color: var(--ink); }
  .logo {
    display: inline-flex;
    padding: var(--space-5) var(--space-6);
    margin-bottom: var(--space-6);
    background: var(--night);
    border-radius: var(--radius);
  }
  .logo img { width: auto; height: 3rem; max-width: 15rem; object-fit: contain; }
  .links { margin-top: var(--space-7); max-width: var(--measure-tech); }
  .links a { display: block; padding-block: var(--space-3); font-weight: 600; }
</style>
