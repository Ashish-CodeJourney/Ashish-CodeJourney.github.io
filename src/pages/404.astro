---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 — Not Found" description="Page not found">
  <div class="error-container">
    <video
      class="error-illustration"
      src="/videos/404.mp4"
      width="324"
      height="324"
      id="error-video"
      autoplay
      muted
      loop
      playsinline
    />
    <span class="error-code">404</span>
    <h2 class="error-title">Journey Interrupted</h2>
    <p class="error-text">
      You've wandered into unmapped territory. This page doesn't exist.
    </p>
    <a href="/" class="button">← Go Home</a>
  </div>

  <script>
    function unmuteOnFirstInteraction() {
      const video = document.getElementById('error-video');
      if (!(video instanceof HTMLVideoElement)) return;

      document.addEventListener('click', () => { video.muted = false; }, { once: true });
    }

    document.addEventListener('astro:page-load', unmuteOnFirstInteraction);
  </script>
</BaseLayout>
