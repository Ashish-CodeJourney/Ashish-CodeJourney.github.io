---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const nowPage = await getEntry('pages', 'now');
const rendered = nowPage ? await render(nowPage) : null;
---

<BaseLayout title="Now" description="What I'm focused on at this moment.">
  <article>
    <header class="collection-header stagger-item">
      <p class="section-eyebrow">Present</p>
      <h1>Now</h1>
      <p class="text-light collection-subtitle">What I'm focused on at this moment.</p>
    </header>
    <div class="post-content stagger-item">
      {rendered ? <rendered.Content /> : <p class="text-light">Nothing to show right now — the <code>pages/now.md</code> content is missing. If you’re developing locally, run <code>git submodule update --init</code>.</p>}
    </div>
  </article>
</BaseLayout>
