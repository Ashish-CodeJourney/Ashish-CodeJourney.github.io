---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Necklace from '../components/home/Necklace.astro';
import Ridgeline from '../components/Ridgeline.astro';
import PostRows from '../components/PostRows.astro';
import { toSlug } from '../utils/slug';
import { SITE } from '../site.config';
import type { NecklacePiece } from '../utils/necklace.js';

const [technical, writings, talks] = await Promise.all([
  getCollection('technical'),
  getCollection('writings'),
  getCollection('talks'),
]);

const newestFirst = <T extends { data: { date: string } }>(entries: ReadonlyArray<T>) =>
  [...entries].sort((a, b) => b.data.date.localeCompare(a.data.date));

const pieces: NecklacePiece[] = [
  ...technical.map((post) => ({ href: `/technical/${toSlug(post.id)}/`, title: post.data.title, date: post.data.date, kind: 'technical' as const })),
  ...writings.map((post) => ({ href: `/writings/${toSlug(post.id)}/`, title: post.data.title, date: post.data.date, kind: 'writing' as const })),
  ...talks.map((talk) => ({ href: `/speaking/${toSlug(talk.id)}/`, title: talk.data.title, date: talk.data.date, kind: 'talk' as const })),
];

const toRow = (base: string) => (entry: { id: string; data: { title: string; date: string; description?: string } }) => ({
  href: `/${base}/${toSlug(entry.id)}/`,
  title: entry.data.title,
  date: entry.data.date,
  summary: entry.data.description,
});

const latestTechnical = newestFirst(technical).slice(0, 4).map(toRow('technical'));
const latestWritings = newestFirst(writings).slice(0, 4).map(toRow('writings'));
const latestTalk = newestFirst(talks)[0];
---

<BaseLayout description="Ashish Vaghela is a software engineer and open source contributor who writes about code, talks at meetups, and keeps a notebook about everything else.">
  <section class="hero" aria-labelledby="hero-name">
    <div class="wrap">
      <p class="greeting" id="greeting">Hi, I'm</p>
      <h1 id="hero-name">Ashish<br />Vaghela</h1>
      <p class="intro">
        I'm a software engineer who builds reliable systems that scale, contributes to open source, and speaks at meetups.
        I also write, about code and about life.
      </p>
      <p class="status"><span class="beacon" aria-hidden="true"></span><span>{SITE.availability} <span class="where">{SITE.location}</span></span></p>
      <p class="hero-cta">
        <a class="primary" href="/resume" target="_blank" rel="noopener">View résumé</a>
        <a href={`mailto:${SITE.email}`}>Email me</a>
      </p>
      <Necklace pieces={pieces} />
    </div>
    <Ridgeline variant="hero" />
  </section>

  <div class="wrap voices">
    <section aria-labelledby="workbench">
      <h2 id="workbench">From the workbench</h2>
      <p class="voice-note">Technical posts on Java, tooling, testing, and the things I break along the way.</p>
      <PostRows items={latestTechnical} voice="tech" />
      <a class="more" href="/technical/">All technical posts</a>
    </section>
    <section aria-labelledby="notebook" class="notebook-col">
      <h2 id="notebook">From the notebook</h2>
      <p class="voice-note">Personal essays. Slower, and mostly not about software.</p>
      <PostRows items={latestWritings} voice="notebook" />
      <a class="more" href="/writings/">All writings</a>
    </section>
  </div>

  <section class="wrap elsewhere" aria-labelledby="elsewhere">
    <h2 id="elsewhere" class="visually-hidden">More from me</h2>
    <dl>
      <div>
        <dt><a href="/oss/">Open source</a></dt>
        <dd>My own projects, the ones I'm a core contributor to, and well-known projects I've contributed to, like MDN and Zod.</dd>
      </div>
      <div>
        <dt><a href="/speaking/">Speaking</a></dt>
        <dd>{latestTalk ? <>Latest: {latestTalk.data.title}, at {latestTalk.data.event}.</> : 'Talks, slides, and how to invite me to your event.'}</dd>
      </div>
      <div>
        <dt><a href="/projects/">Projects</a></dt>
        <dd>Things I've built on my own time.</dd>
      </div>
      <div>
        <dt><a href="/now/">Now</a></dt>
        <dd>What I'm learning and working on this month.</dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<script>
  import { greetingFor } from '../utils/greeting.js';

  function greet() {
    const el = document.getElementById('greeting');
    if (el) el.textContent = greetingFor(new Date().getHours());
  }

  document.addEventListener('astro:page-load', greet);
</script>

<style>
  .hero {
    background: var(--sky);
    color: var(--sky-ink);
    padding-top: var(--space-8);
    overflow: hidden;
  }
  .greeting {
    color: var(--sky-accent);
    font-size: var(--step-1);
    font-weight: 500;
    min-height: 1.6em;
  }
  h1 {
    font-size: var(--display);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
    margin-top: var(--space-3);
  }
  .intro {
    margin-top: var(--space-5);
    max-width: 34ch;
    font-size: var(--step-2);
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--sky-ink);
  }

  .status {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    column-gap: var(--space-3);
    margin-top: var(--space-5);
    max-width: 52ch;
    color: var(--sky-ink);
    font-weight: 500;
  }
  .beacon {
    flex: none;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--lamp-glow);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--lamp-glow) 30%, transparent);
    transform: translateY(-0.05em);
  }
  .where { color: var(--sky-accent); white-space: nowrap; margin-left: var(--space-1); }
  .hero-cta { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-4); }
  .hero-cta a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--sky-ink) 45%, transparent);
    border-radius: 999px;
    color: var(--sky-ink);
    font-weight: 600;
    text-decoration: none;
  }
  .hero-cta a:hover { border-color: var(--lamp-glow); }
  .hero-cta .primary { background: var(--sky-ink); color: var(--sky); border-color: var(--sky-ink); }
  .hero-cta .primary:hover { box-shadow: 0 0 0 3px var(--lamp-glow); }

  .voices {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    padding-top: var(--space-7);
  }
  .voices h2 { font-size: var(--step-3); letter-spacing: -0.03em; }
  .notebook-col h2 { font-family: var(--font-serif); font-weight: 500; letter-spacing: -0.01em; }
  .voice-note { color: var(--ink-2); margin-block: var(--space-2) var(--space-5); max-width: 40ch; }
  .notebook-col .voice-note { font-family: var(--font-serif); font-size: var(--step-1); }
  .more { display: inline-block; margin-top: var(--space-4); font-weight: 600; }

  .voices :global(.post-rows a) { grid-template-columns: 1fr; }
  .voices :global(.post-rows time) { grid-row: auto; }
  .voices :global(.post-rows .summary) { grid-column: 1; }

  .elsewhere { padding-top: var(--space-8); }
  dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    border-top: 2px solid var(--ink);
    padding-top: var(--space-4);
  }
  dt { font-size: var(--step-1); font-weight: 650; letter-spacing: -0.02em; }
  dt a { color: var(--ink); text-decoration: none; }
  dt a:hover { color: var(--lamp); }
  dd { margin-top: var(--space-2); color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }

  @media (max-width: 600px) {
    .hero { padding-top: var(--space-6); }
    .intro { font-size: var(--step-1); line-height: 1.4; margin-top: var(--space-4); }
  }

  @media (max-width: 860px) {
    .voices { grid-template-columns: 1fr; gap: var(--space-8); }
    dl { grid-template-columns: 1fr 1fr; row-gap: var(--space-6); }
  }
  @media (max-width: 480px) {
    dl { grid-template-columns: 1fr; }
  }
</style>
