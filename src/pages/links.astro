---
import QRCode from 'qrcode';
import BaseLayout from '../layouts/BaseLayout.astro';
import BrandIcon from '../components/BrandIcon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE, LINKS } from '../site.config';

const linksUrl = `${SITE.url}/links/`;
const displayUrl = linksUrl.replace(/^https?:\/\//, '').replace(/\/$/, '');
const homeLabel = new URL(SITE.url).host;

const qrSvg = (await QRCode.toString(linksUrl, { type: 'svg', margin: 1, width: 320 })).replace(
  '<svg ',
  `<svg class="qr" role="img" aria-label="QR code that opens ${displayUrl}" `,
);

type SiteLink = (typeof LINKS)[number];
type Profile = SiteLink & { icon: Exclude<SiteLink['icon'], 'website'> };
const isProfile = (link: SiteLink): link is Profile => link.icon !== 'website';
const profiles = LINKS.filter(isProfile);
---

<BaseLayout title="Links" description={`Find ${SITE.author} on the web.`} chrome={false}>
  <div class="stage">
    <div class="card">
      <header class="intro">
        <img src="/avatar.jpg" alt="" width="400" height="400" loading="eager" decoding="async" />
        <div>
          <h1>{SITE.author}</h1>
          <p>Software engineer and open source contributor</p>
        </div>
      </header>

      <ul class="links">
        {profiles.map(({ label, username, url, icon }) => (
          <li>
            <a href={url} target="_blank" rel="me noopener noreferrer">
              <BrandIcon name={icon} />
              <span class="label">{label}</span>
              <span class="handle">{username}</span>
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${SITE.email}`}>
            <svg class="brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
            <span class="label">Email</span>
            <span class="handle">{SITE.email}</span>
          </a>
        </li>
        <li>
          <a href="/resume/developer-advocate">
            <svg class="brand" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></svg>
            <span class="label">Résumé</span>
            <span class="handle">PDF</span>
          </a>
        </li>
      </ul>

      <footer class="foot">
        <a href="/">{homeLabel}</a>
        <ThemeToggle />
      </footer>
    </div>

    <figure class="scan">
      <Fragment set:html={qrSvg} />
      <figcaption>
        <strong>Scan to open this page</strong>
        <span>{displayUrl}</span>
      </figcaption>
    </figure>
  </div>
</BaseLayout>

<style>
  .stage {
    min-height: 100dvh;
    display: grid;
    grid-template-columns: minmax(0, 28rem) auto;
    justify-content: center;
    align-items: center;
    gap: clamp(var(--space-6), 6vw, var(--space-9));
    padding: var(--space-6) var(--space-5);
    background: var(--sky);
    color: var(--sky-ink);
  }

  .intro { display: flex; align-items: center; gap: var(--space-4); }
  .intro img { width: 4.5rem; height: 4.5rem; border-radius: 50%; object-fit: cover; flex: none; }
  .intro h1 { font-size: var(--step-3); letter-spacing: -0.035em; line-height: 1.05; }
  .intro p { margin-top: var(--space-1); color: var(--sky-ink-2); }

  .links { list-style: none; padding: 0; display: grid; gap: var(--space-2); margin-top: var(--space-5); }
  .links a {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--sky-line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
    transition: border-color 120ms ease-out;
  }
  .links a:hover { border-color: var(--lamp); }
  .links :global(.brand) { grid-row: span 2; width: 1.4rem; height: 1.4rem; }
  .label { font-weight: 650; line-height: 1.2; }
  .handle { color: var(--ink-2); font-size: var(--step--1); overflow-wrap: anywhere; line-height: 1.3; }

  .foot { display: flex; align-items: center; justify-content: space-between; margin-top: var(--space-5); }
  .foot a { color: var(--sky-accent); font-weight: 600; }

  .scan { display: grid; justify-items: center; gap: var(--space-4); text-align: center; }
  .scan :global(.qr) {
    width: min(48vh, 34vw, 34rem);
    height: auto;
    padding: var(--space-4);
    background: #ffffff;
    border-radius: var(--radius);
  }
  .scan :global(.qr path[fill]) { fill: #ffffff; }
  .scan :global(.qr path[stroke]) { stroke: #0f212c; }
  .scan figcaption { display: grid; gap: var(--space-1); }
  .scan strong { font-size: var(--step-2); letter-spacing: -0.02em; }
  .scan span { color: var(--sky-ink-2); font-size: var(--step-1); }

  @media (min-width: 861px) and (max-height: 820px) {
    .stage { padding-block: var(--space-4); }
    .links { gap: var(--space-1); margin-top: var(--space-4); }
    .links a { padding-block: var(--space-2); }
    .foot { margin-top: var(--space-3); }
  }

  @media (min-width: 1500px) and (min-height: 900px) {
    :global(html) { font-size: clamp(16px, 0.75vw + 6px, 24px); }
  }

  @media (max-width: 860px) {
    .stage { grid-template-columns: minmax(0, 28rem); align-items: start; padding-top: var(--space-7); }
    .scan { display: none; }
  }
</style>
