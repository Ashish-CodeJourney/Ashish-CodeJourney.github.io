---
import { SITE } from '../site.config';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/tokens.css';
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex" />
  <title>Leaving {SITE.author}'s site</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <script>
    import theme from '../utils/theme.js';

    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    theme.applyTheme(document.documentElement, theme.resolveTheme({ storedTheme: stored, prefersDark }));
  </script>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; }

    body {
      min-height: 100svh;
      display: grid;
      place-items: center;
      padding: var(--space-5);
      background: var(--bg);
      color: var(--ink);
      font-family: var(--font-ui);
      font-size: var(--step-0);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
    }

    main { width: 100%; max-width: 30rem; }

    h1 {
      font-size: var(--step-3);
      font-weight: 650;
      letter-spacing: -0.03em;
      line-height: 1.1;
    }

    p { margin-top: var(--space-3); color: var(--ink-2); }
    #label { color: var(--ink); font-weight: 600; overflow-wrap: anywhere; }

    .actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-3) var(--space-5);
      margin-top: var(--space-6);
      padding-top: var(--space-5);
      border-top: 1px solid var(--line);
    }

    a { color: var(--lamp); font-weight: 600; text-underline-offset: 0.2em; text-decoration-thickness: 1px; }
    a:hover { text-decoration-thickness: 2px; }

    .go {
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius);
      background: var(--lamp);
      color: var(--bg);
      text-decoration: none;
    }
    .go:hover { background: var(--ink); }

    :focus-visible { outline: 2px solid var(--lamp); outline-offset: 3px; border-radius: 2px; }
  </style>
</head>
<body>
  <main>
    <h1>You're leaving my site</h1>
    <p>Taking you to <span id="label">an external site</span> in <span id="seconds">3</span> seconds.</p>
    <div class="actions">
      <a id="go" class="go" href="/">Go now</a>
      <a id="stay" href="/">Stay on this site</a>
    </div>
  </main>

  <script>
    import { safeDestination } from '../utils/redirect-target.js';

    const ALLOWED = ['twitter.com', 'x.com', 'linkedin.com', 'instagram.com', 'github.com'];
    const params = new URLSearchParams(window.location.search);
    const destination = safeDestination({ url: params.get('url'), allowed: ALLOWED });

    const go = document.getElementById('go');
    const label = document.getElementById('label');
    const seconds = document.getElementById('seconds');

    go?.setAttribute('href', destination);
    if (label) label.textContent = params.get('label') ?? new URL(destination, window.location.href).hostname;

    const DELAY_SECONDS = 3;
    const startedAt = Date.now();

    const tick = setInterval(() => {
      const remaining = Math.max(0, DELAY_SECONDS - Math.floor((Date.now() - startedAt) / 1000));
      if (seconds) seconds.textContent = String(remaining);
      if (remaining > 0) return;
      clearInterval(tick);
      window.location.href = destination;
    }, 250);

    document.getElementById('stay')?.addEventListener('click', () => clearInterval(tick));
  </script>
</body>
</html>
