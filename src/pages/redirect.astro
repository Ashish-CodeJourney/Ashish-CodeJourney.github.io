---
import { SITE } from '../site.config';

const url = Astro.url.searchParams.get('url') ?? '/';
const label = Astro.url.searchParams.get('label') ?? 'an external site';

// Allowlist: only redirect to known social domains
const allowed = [
  'twitter.com', 'x.com',
  'linkedin.com',
  'instagram.com',
  'github.com',
];

let destination = '/';
try {
  const parsed = new URL(url);
  if (allowed.some(domain => parsed.hostname === domain || parsed.hostname.endsWith('.' + domain))) {
    destination = url;
  }
} catch {
  // invalid URL — fall through to home
}
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leaving {SITE.title}</title>
  <link rel="icon" type="image/jpeg" href="/avatar.jpg" />
  <link rel="stylesheet" href="/oat.min.css" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap"
    rel="stylesheet"
  />

  <script is:inline>
    (function () {
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
        document.documentElement.style.colorScheme = 'dark';
      }
    })();
  </script>

  <style>
    :root {
      --font-sans: 'DM Sans', system-ui, sans-serif;
      --background: light-dark(#FAF8F5, #0D1117);
      --foreground: light-dark(#111210, #F0EDE8);
      --primary: light-dark(#C2956C, #D4A87A);
      --muted: light-dark(#F0EBE3, #1E2530);
      --muted-foreground: light-dark(#7C6E5E, #8A9BAD);
      --border: light-dark(#DDD5C8, #2A3340);
      --card: light-dark(#FFFFFF, #161B22);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: var(--font-sans);
      background: var(--background);
      color: var(--foreground);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100svh;
      padding: 1.5rem;
    }

    .card {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      max-width: 420px;
      width: 100%;
      text-align: center;
      box-shadow: 0 4px 24px rgba(0,0,0,.07);
      animation: fadeUp 0.4s cubic-bezier(.16,1,.3,1) both;
    }

    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .icon-wrap {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: var(--muted);
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 1.25rem;
    }

    .icon-wrap svg { width: 24px; height: 24px; color: var(--primary); }

    h1 {
      font-family: var(--font-sans);
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--foreground);
    }

    p {
      font-size: 0.875rem;
      color: var(--muted-foreground);
      line-height: 1.6;
      margin-bottom: 1.5rem;
    }

    p strong {
      color: var(--foreground);
      word-break: break-all;
    }

    .progress-bar {
      height: 3px;
      background: var(--muted);
      border-radius: 99px;
      overflow: hidden;
      margin-bottom: 1.5rem;
    }

    .progress-fill {
      height: 100%;
      width: 0%;
      background: var(--primary);
      border-radius: 99px;
      animation: fill 3s linear forwards;
    }

    @keyframes fill { to { width: 100%; } }

    .actions {
      display: flex;
      gap: 0.75rem;
      justify-content: center;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.5rem 1.1rem;
      border-radius: 99px;
      font-size: 0.82rem;
      font-weight: 500;
      font-family: var(--font-sans);
      cursor: pointer;
      text-decoration: none;
      transition: opacity 0.15s, transform 0.15s;
      border: 1px solid transparent;
    }
    .btn:hover { opacity: 0.85; transform: translateY(-1px); }

    .btn-primary {
      background: var(--primary);
      color: #fff;
    }

    .btn-outline {
      background: transparent;
      border-color: var(--border);
      color: var(--muted-foreground);
    }

    .timer {
      font-size: 0.75rem;
      color: var(--muted-foreground);
      margin-top: 1rem;
    }

    #seconds { font-weight: 600; color: var(--primary); }
  </style>
</head>
<body>
  <div class="card">
    <div class="icon-wrap">
      <!-- External link icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
        <polyline points="15 3 21 3 21 9"/>
        <line x1="10" y1="14" x2="21" y2="3"/>
      </svg>
    </div>

    <h1>You're leaving {SITE.title}</h1>
    <p>
      You're being redirected to <strong>{label}</strong>.
      This will happen automatically in <span id="seconds">3</span>s.
    </p>

    <div class="progress-bar">
      <div class="progress-fill"></div>
    </div>

    <div class="actions">
      <a id="go-btn" href={destination} class="btn btn-primary">
        Go now
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
      <a href="/" class="btn btn-outline">
        ← Stay here
      </a>
    </div>
  </div>

  <script is:inline define:vars={{ destination }}>
    let remaining = 3;
    const el = document.getElementById('seconds');

    const tick = setInterval(() => {
      remaining -= 1;
      if (el) el.textContent = String(remaining);
      if (remaining <= 0) {
        clearInterval(tick);
        window.location.href = destination;
      }
    }, 1000);

    // Cancel auto-redirect if user clicks "Stay here"
    document.querySelectorAll('a[href="/"]').forEach(a => {
      a.addEventListener('click', () => clearInterval(tick));
    });
  </script>
</body>
</html>
