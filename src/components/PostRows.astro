---
import { formatDate } from '../utils/date';

type Row = { href: string; title: string; date: string; summary?: string };

interface Props {
  items: ReadonlyArray<Row>;
  voice?: 'tech' | 'notebook';
}

const { items, voice = 'tech' } = Astro.props;
---

<ul class:list={['rows', 'post-rows', voice]}>
  {items.map((item) => (
    <li>
      <a href={item.href}>
        <time datetime={item.date}>{formatDate(item.date)}</time>
        <span class="title">{item.title}</span>
        {item.summary && <span class="summary">{item.summary}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  a {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    column-gap: var(--space-5);
    row-gap: var(--space-1);
    padding-block: var(--space-4);
    color: var(--ink);
    text-decoration: none;
  }
  time { grid-row: span 2; color: var(--ink-2); font-size: var(--step--1); padding-top: 0.2em; }
  .title { font-weight: 600; font-size: var(--step-1); letter-spacing: -0.015em; line-height: 1.3; }
  .summary { grid-column: 2; color: var(--ink-2); font-size: var(--step--1); line-height: 1.5; }
  a:hover .title { color: var(--lamp); }

  .notebook .title { font-family: var(--font-serif); font-weight: 500; font-size: var(--step-2); letter-spacing: -0.01em; }
  .notebook .summary { font-family: var(--font-serif); font-size: var(--step-0); }

  @media (max-width: 600px) {
    a { grid-template-columns: 1fr; }
    time { grid-row: auto; }
    .summary { grid-column: 1; }
  }
</style>
