---
import type { TocEntry } from '../utils/technical-archive.js';

interface Props {
  entries: ReadonlyArray<TocEntry>;
}

const { entries } = Astro.props;
---

<ol>
  {entries.map((entry) => (
    <li>
      <a href={`#${entry.slug}`}>{entry.text}</a>
      {entry.children.length > 0 && (
        <ol>
          {entry.children.map((child) => (
            <li><a href={`#${child.slug}`}>{child.text}</a></li>
          ))}
        </ol>
      )}
    </li>
  ))}
</ol>

<style>
  ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }
  ol ol {
    margin-top: var(--space-2);
    padding-left: var(--space-4);
  }
  a {
    color: var(--ink-2);
    text-decoration: none;
    font-size: var(--step--1);
    line-height: 1.4;
    display: block;
  }
  a:hover {
    color: var(--lamp);
  }
</style>
