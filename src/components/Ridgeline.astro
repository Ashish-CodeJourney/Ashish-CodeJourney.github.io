const CAT_BODY =
  'M30 120 C22 100 20 80 28 62 C32 52 38 46 44 42 L42 30 C42 22 46 16 50 14 L49 3 L57 11 C60 10 64 10 67 11 L72 2 L74 15 C78 20 79 27 76 33 C74 37 69 40 64 41 C66 50 68 60 66 72 C70 84 72 100 70 120 Z';
const CAT_TAIL = 'M32 117 C18 120 6 114 8 100 C9 92 4 88 0 90';
---

<svg
  class:list={['ridgeline', variant]}
  viewBox="0 0 1440 240"
  preserveAspectRatio="xMaxYMax slice"
  aria-hidden="true"
  focusable="false"
>
  <circle class="moon-halo" cx="1080" cy="62" r="52" />
  <circle class="moon" cx="1080" cy="62" r="26" />
  <path class="ridge far" d={RIDGES.far} />
  <path class="ridge mid" d={RIDGES.mid} />
  <path class="ridge near" d={RIDGES.near} />
  <g class="cat" transform="translate(1150 112) scale(0.7)">
    <path class="cat-body" d={CAT_BODY} />
    <path class="cat-tail" d={CAT_TAIL} />
  </g>
</svg>

<style>
  .ridgeline {
    display: block;
    width: 100%;
    height: clamp(96px, 15vw, 220px);
    overflow: visible;
  }

  .hero {
    --sky-far: color-mix(in srgb, var(--sky) 82%, var(--sky-ink));
    --sky-mid: color-mix(in srgb, var(--sky) 68%, var(--sky-ink));
    --ground: var(--bg);
  }

  .footer {
    --sky-far: color-mix(in srgb, var(--bg) 76%, var(--footer-band));
    --sky-mid: color-mix(in srgb, var(--bg) 48%, var(--footer-band));
    --ground: var(--footer-band);
  }
  :global(html.dark) .footer {
    --sky-far: color-mix(in srgb, var(--footer-band) 90%, var(--sky-ink));
    --sky-mid: color-mix(in srgb, var(--footer-band) 80%, var(--sky-ink));
  }

  .far { fill: var(--sky-far); }
  .mid { fill: var(--sky-mid); }
  .near { fill: var(--ground); }
  .cat-body { fill: var(--cat); }
  .cat-tail {
    fill: none;
    stroke: var(--cat);
    stroke-width: 7;
    stroke-linecap: round;
    transform-box: fill-box;
    transform-origin: 100% 85%;
    animation: tail-sway 5s ease-in-out infinite alternate;
  }

  .moon { fill: var(--celestial); }
  .moon-halo { fill: var(--celestial); opacity: 0.14; }

  @keyframes tail-sway {
    from { rotate: -7deg; }
    to { rotate: 6deg; }
  }
</style>
