---
import { formatDate } from '../utils/date';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags: string[];
  banner?: string;
  href: string;
  readingTime?: string;
}

const { title, date, description, tags, banner, href, readingTime } = Astro.props;
---

<div class="post-item stagger-item">
  <a href={href} class="post-card">
    {readingTime && <span class="post-bookmark" aria-hidden="true">{readingTime.replace(' read', '').replace(' ', '\n')}</span>}
    {banner && (
      <img
        src={banner}
        alt={title}
        class="post-card-banner"
        width="700"
        height="180"
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="post-card-body">
      <span class="post-card-date">{formatDate(date)}</span>
      <h3>{title}</h3>
      {description && <p class="post-card-desc">{description}</p>}
      {tags.length > 0 && (
        <div class="post-card-tags">
          {tags.map(tag => <span class="badge secondary post-tag">{tag}</span>)}
        </div>
      )}
    </div>
  </a>
</div>
