---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { RESUMES } from '../site.config';
import { formatFileSize } from '../utils/resume.js';

interface Props {
  layout?: 'panel' | 'inline';
}

const { layout = 'inline' } = Astro.props;
const resumes = RESUMES.map((resume) => ({
  ...resume,
  size: formatFileSize(statSync(join(process.cwd(), 'public', resume.pdf)).size),
}));
---

<div class:list={['resume', layout]}>
  {layout === 'panel' && <p class="label">Résumé</p>}
  {resumes.map((resume) => (
    <div class="variant">
      <p class="title">{resume.title}</p>
      <p class="meta">PDF, {resume.size}</p>
      <p class="actions">
        <a class="primary" href={resume.view} target="_blank" rel="noopener">View résumé</a>
        <a href={resume.pdf} download>Download PDF</a>
      </p>
    </div>
  ))}
</div>

<style>
  .resume { margin-top: var(--space-5); }
  .panel {
    max-width: 18rem;
    padding: var(--space-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .label { font-weight: 650; font-size: var(--step-1); letter-spacing: -0.015em; }
  .variant + .variant { margin-top: var(--space-4); }
  .title { font-weight: 600; }
  .meta { color: var(--ink-2); font-size: var(--step--1); }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-3); }
  .actions a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding-inline: var(--space-4);
    border: 1px solid var(--lamp);
    border-radius: var(--radius);
    font-weight: 600;
    text-decoration: none;
  }
  .actions .primary { background: var(--lamp); color: var(--bg); }
  .actions a:hover { border-color: var(--ink); }
  .actions .primary:hover { background: var(--ink); color: var(--bg); }
</style>
