---
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Switch to dark theme">
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4.5" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  import theme from '../utils/theme.js';

  const label = (isDark: boolean) => (isDark ? 'Switch to light theme' : 'Switch to dark theme');

  function setup() {
    const button = document.getElementById('theme-toggle');
    if (!button) return;

    button.setAttribute('aria-label', label(document.documentElement.classList.contains('dark')));
    button.onclick = () => {
      const nextTheme = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
      theme.applyTheme(document.documentElement, nextTheme);
      localStorage.setItem('theme', nextTheme);
      button.setAttribute('aria-label', label(nextTheme === 'dark'));
    };
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--lamp); color: var(--lamp); }
  .icon-sun { display: none; }
  :global(html.dark) .icon-sun { display: block; }
  :global(html.dark) .icon-moon { display: none; }
</style>
