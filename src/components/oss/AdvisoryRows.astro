---
import type { Advisory } from '../../utils/featured.js';

type Props = { advisories: ReadonlyArray<Advisory> };

const { advisories } = Astro.props;

const publishedOn = (date: string) =>
  new Date(`${date}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<ol class="advisories">
  {advisories.map((advisory) => (
    <li data-advisory={advisory.id}>
      <div class="side">
        <p class="project">{advisory.project}</p>
        <p class="severity" data-severity={advisory.severity.toLowerCase()}>
          {advisory.severity} <span class="score">CVSS {advisory.cvss}</span>
        </p>
        <p class="meta">
          Published <time datetime={advisory.published}>{publishedOn(advisory.published)}</time>
        </p>
      </div>
      <div class="about">
        <h3><a href={advisory.url}>{advisory.title}</a></h3>
        <p class="facts">
          <span>{advisory.id}</span>
          <span>{advisory.cwe}</span>
          {advisory.fixedIn && <span>Fixed in {advisory.fixedIn}</span>}
        </p>
        {advisory.summary && <p class="summary">{advisory.summary}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .advisories { list-style: none; padding: 0; }

  .advisories > li {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    column-gap: var(--space-6);
    padding-block: var(--space-5);
    border-top: 1px solid var(--line);
  }

  .project { font-size: var(--step-1); font-weight: 600; line-height: 1.3; }

  .severity {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid currentColor;
    border-radius: 999px;
    color: var(--lamp);
    font-size: var(--step--1);
    font-weight: 700;
  }
  .score { font-weight: 600; font-variant-numeric: tabular-nums; }

  .meta { margin-top: var(--space-2); color: var(--ink-2); font-size: var(--step--1); }

  .about { max-width: var(--measure-tech); line-height: 1.5; }

  h3 { font-size: var(--step-1); line-height: 1.3; }
  h3 a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  h3 a:hover { color: var(--lamp); text-decoration-color: currentColor; }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
  }
  .facts span {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    font-family: var(--font-code);
    font-size: var(--step--1);
  }

  .summary { margin-top: var(--space-3); color: var(--ink-2); }

  @media (max-width: 760px) {
    .advisories > li { grid-template-columns: 1fr; row-gap: var(--space-3); }
  }
</style>
