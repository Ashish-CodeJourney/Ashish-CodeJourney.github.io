---
type Props = { project?: string };

const { project } = Astro.props;
---

<li data-project={project}>
  <div class="side">
    <h3><slot name="name" /></h3>
    <slot name="meta" />
  </div>
  <div class="about">
    <slot />
  </div>
</li>

<style>
  li {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    column-gap: var(--space-6);
    padding-block: var(--space-5);
  }

  h3 { font-size: var(--step-1); line-height: 1.3; overflow-wrap: break-word; }
  h3 :global(a) {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  h3 :global(a:hover) { color: var(--lamp); text-decoration-color: currentColor; }

  .side :global(.meta) { margin-top: var(--space-1); color: var(--ink-2); font-size: var(--step--1); }
  .side :global(.meta:first-of-type) { color: var(--lamp); font-weight: 600; }

  .about { max-width: var(--measure-tech); line-height: 1.5; }
  .about :global(.quiet) { color: var(--ink-2); }
  .about :global(* + *) { margin-top: var(--space-2); }
  .about :global(.about-link) { color: var(--ink); text-decoration-color: var(--line); }
  .about :global(.about-link:hover) { color: var(--lamp); text-decoration-color: currentColor; }

  @media (max-width: 760px) {
    li { grid-template-columns: 1fr; row-gap: var(--space-3); }
  }
</style>
