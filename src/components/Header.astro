---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'Writings', href: '/writings/' },
  { label: 'Technical', href: '/technical/' },
  { label: 'Now', href: '/now/' },
] as const;

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="site-header hstack justify-between">
  <a href="/" class="brand-link" aria-label="Home">
    <svg class="brand-logo" height="32" viewBox="0 0 320 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <text x="2" y="57" fill="currentColor" opacity="0.12"
            style="font-family:'DM Serif Display',Georgia,serif;font-size:58px;font-weight:400;letter-spacing:-1px;">Ashish</text>
      <text x="0" y="54" fill="currentColor"
            style="font-family:'DM Serif Display',Georgia,serif;font-size:58px;font-weight:400;letter-spacing:-1px;">Ashish</text>
      <text x="0" y="54" fill="var(--primary)"
            style="font-family:'DM Serif Display',Georgia,serif;font-size:58px;font-weight:400;font-style:italic;letter-spacing:-1px;">A</text>
      <rect x="0" y="60" width="36" height="3" rx="1.5" fill="var(--primary)"/>
    </svg>
  </a>

  <div class="hstack gap-4">
    <nav class="desktop-nav hstack gap-4" aria-label="Main navigation">
      {navItems.map(({ label, href }) => (
        <a
          href={href}
          class:list={['nav-link', { active: isActive(href) }]}
          aria-current={isActive(href) ? 'page' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>

    <button
      id="mobile-menu-toggle"
      class="button icon-only mobile-menu-toggle"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
           stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="3" y1="12" x2="21" y2="12"/>
        <line x1="3" y1="6" x2="21" y2="6"/>
        <line x1="3" y1="18" x2="21" y2="18"/>
      </svg>
    </button>
  </div>
</header>

<nav id="mobile-nav" class="mobile-nav" hidden aria-label="Mobile navigation">
  {navItems.map(({ label, href }) => (
    <a
      href={href}
      class:list={['nav-link', { active: isActive(href) }]}
      aria-current={isActive(href) ? 'page' : undefined}
    >
      {label}
    </a>
  ))}
  <label class="mobile-theme-wrapper hstack justify-between" style="margin-top: 1rem;">
    <span id="mobile-theme-label" class="text-light" style="font-size:var(--text-7);">Light mode</span>
    <input type="checkbox" id="mobile-theme-switch" role="switch" aria-label="Toggle dark mode" />
  </label>
</nav>

<script>
  function setup() {
    const toggle = document.getElementById('mobile-menu-toggle') as HTMLButtonElement;
    const nav = document.getElementById('mobile-nav') as HTMLElement;
    const mobileSwitch = document.getElementById('mobile-theme-switch') as HTMLInputElement;
    const mobileLabel = document.getElementById('mobile-theme-label') as HTMLElement;

    const mq = window.matchMedia('(max-width: 640px)');

    function syncVisibility(e: MediaQueryList | MediaQueryListEvent) {
      toggle.style.display = e.matches ? 'inline-flex' : 'none';
      if (!e.matches) nav.hidden = true;
    }

    function syncTheme() {
      const isDark = document.documentElement.classList.contains('dark');
      mobileSwitch.checked = isDark;
      mobileLabel.textContent = isDark ? 'Dark mode' : 'Light mode';
    }

    syncVisibility(mq);
    syncTheme();

    mq.addEventListener('change', syncVisibility);

    toggle.addEventListener('click', () => {
      const opening = nav.hidden;
      nav.hidden = !opening;
      toggle.setAttribute('aria-expanded', String(opening));
    });

    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).tagName === 'A') nav.hidden = true;
    });

    mobileSwitch.addEventListener('change', () => {
      const dark = mobileSwitch.checked;
      document.documentElement.classList.toggle('dark', dark);
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
      localStorage.setItem('theme', dark ? 'dark' : 'light');
      mobileLabel.textContent = dark ? 'Dark mode' : 'Light mode';
    });
  }

  document.addEventListener('astro:page-load', setup);
</script>
