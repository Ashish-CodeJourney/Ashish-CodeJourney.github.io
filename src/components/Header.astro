---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../site.config';

const navItems = [
  { label: 'Technical', href: '/technical/' },
  { label: 'Writings', href: '/writings/' },
  { label: 'Projects', href: '/projects/' },
  { label: 'Open source', href: '/oss/' },
  { label: 'Speaking', href: '/speaking/' },
  { label: 'About', href: '/about/' },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="name" aria-label={`${SITE.author}, home`}>{SITE.author}</a>
    <nav id="main-nav" aria-label="Main">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="tools">
      <ThemeToggle />
      <button type="button" class="menu-toggle" aria-controls="main-nav" aria-expanded="false" data-menu-toggle>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path class="bars" d="M4 7h16M4 12h16M4 17h16" />
          <path class="cross" d="M6 6l12 12M18 6L6 18" />
        </svg>
        <span>Menu</span>
      </button>
    </div>
  </div>
</header>

<script>
  let listeners = new AbortController();

  function setup() {
    listeners.abort();
    listeners = new AbortController();

    const header = document.querySelector<HTMLElement>('.site-header');
    const toggle = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
    if (!header || !toggle) return;

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      header.classList.toggle('menu-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener(
      'keydown',
      (event) => {
        if (event.key === 'Escape' && header.classList.contains('menu-open')) {
          setOpen(false);
          toggle.focus();
        }
      },
      { signal: listeners.signal },
    );
  }

  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    position: relative;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    z-index: 4;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-5);
    min-height: 4.25rem;
  }
  .name {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    padding-block: var(--space-2);
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--lamp-glow);
  }

  .tools { display: flex; align-items: center; gap: var(--space-2); }
  .menu-toggle {
    display: none;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.5rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-weight: 600;
    font-size: var(--step--1);
    cursor: pointer;
  }
  .menu-toggle:hover { border-color: var(--lamp); }
  .cross { display: none; }
  .menu-open .cross { display: inline; }
  .menu-open .bars { display: none; }

  @media (max-width: 860px) {
    .bar { grid-template-columns: 1fr auto; gap: var(--space-3); }
    nav { grid-column: 1 / -1; grid-row: 2; padding-bottom: var(--space-3); }
    ul { flex-wrap: wrap; gap: var(--space-1) var(--space-4); }

    :global(html.js) .menu-toggle { display: inline-flex; }
    :global(html.js) nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto 0;
      padding: var(--space-2) clamp(var(--space-4), 5vw, var(--space-6)) var(--space-5);
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: 0 16px 24px -16px color-mix(in srgb, var(--ink) 35%, transparent);
    }
    :global(html.js) .menu-open nav { display: block; }
    :global(html.js) ul { flex-direction: column; gap: 0; }
    :global(html.js) nav li + li { border-top: 1px solid var(--line); }
    :global(html.js) nav a {
      display: block;
      padding-block: var(--space-4);
      font-size: var(--step-1);
      font-weight: 600;
      color: var(--ink);
    }
    :global(html.js) nav a[aria-current='page'] { box-shadow: none; color: var(--lamp); }
  }
</style>
