---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../site.config';

const navItems = [
  { label: 'Technical', href: '/technical/' },
  { label: 'Writings', href: '/writings/' },
  { label: 'Open source', href: '/oss/' },
  { label: 'Speaking', href: '/speaking/' },
  { label: 'About', href: '/about/' },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="name" aria-label={`${SITE.author}, home`}>{SITE.author}</a>
    <nav aria-label="Main">
      <ul>
        {navItems.map((item) => (
          <li>
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-5);
    min-height: 4.25rem;
  }
  .name {
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  ul {
    display: flex;
    gap: var(--space-5);
    list-style: none;
    padding: 0;
  }
  nav a {
    color: var(--ink-2);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
    padding-block: var(--space-2);
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] {
    color: var(--ink);
    box-shadow: inset 0 -2px 0 var(--lamp-glow);
  }

  @media (max-width: 760px) {
    .bar {
      grid-template-columns: 1fr auto;
      padding-top: var(--space-3);
      row-gap: 0;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-4);
      scrollbar-width: none;
    }
    ul { gap: var(--space-4); padding-block: var(--space-2); }
  }
</style>
