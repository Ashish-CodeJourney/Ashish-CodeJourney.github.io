---
import { SITE } from '../site.config';
import Ridgeline from './Ridgeline.astro';

const elsewhere = [
  { label: 'GitHub', href: SITE.socials.github },
  { label: 'LinkedIn', href: SITE.socials.linkedin },
  { label: 'X', href: SITE.socials.twitter },
  { label: 'Instagram', href: SITE.socials.instagram },
  { label: 'dev.to', href: 'https://dev.to/Ashish-CodeJourney' },
];

const site = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Now', href: '/now/' },
  { label: 'Links', href: '/links/' },
  { label: 'Sponsors', href: '/sponsors/' },
  { label: 'RSS feed', href: '/rss.xml' },
];

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <Ridgeline variant="footer" />
  <div class="night">
  <div class="wrap grid">
    <div class="say-hi">
      <p class="lead">Want to talk about open source, a talk, or street cats?</p>
      <a class="mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
    <nav aria-label="Elsewhere">
      <h2>Elsewhere</h2>
      <ul>{elsewhere.map((item) => <li><a href={item.href} rel="me noopener" target="_blank">{item.label}</a></li>)}</ul>
    </nav>
    <nav aria-label="More on this site">
      <h2>On this site</h2>
      <ul>{site.map((item) => <li><a href={item.href}>{item.label}</a></li>)}</ul>
    </nav>
    <p class="legal">
      © {year} {SITE.author}. Words under <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>, code under <a href="https://www.gnu.org/licenses/agpl-3.0.html">AGPL v3</a> with <a href="https://github.com/Ashish-CodeJourney/Ashish-CodeJourney.github.io">source on GitHub</a>.
    </p>
  </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-9);
    font-size: var(--step--1);
  }
  .night {
    background: var(--footer-band);
    color: var(--night-ink);
    padding-block: var(--space-6) var(--space-6);
    margin-top: -1px;
  }
  .grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-6);
  }
  .lead { font-size: var(--step-1); font-weight: 600; letter-spacing: -0.015em; line-height: 1.3; max-width: 22ch; }
  .mail { display: inline-block; margin-top: var(--space-3); font-size: var(--step-0); color: var(--lamp-glow); }
  h2 { font-size: var(--step--1); font-weight: 600; color: var(--night-ink-2); letter-spacing: 0; margin-bottom: var(--space-3); }
  ul { list-style: none; padding: 0; display: grid; gap: var(--space-2); }
  nav a { color: var(--night-ink); text-decoration: none; }
  nav a:hover { color: var(--lamp-glow); }
  a:focus-visible { outline-color: var(--lamp-glow); }
  .legal { grid-column: 1 / -1; color: var(--night-ink-2); padding-top: var(--space-5); border-top: 1px solid var(--night-line); }
  .legal a { color: inherit; }
  @media (max-width: 760px) {
    .grid { grid-template-columns: 1fr 1fr; }
    .say-hi { grid-column: 1 / -1; }
  }
</style>
