---
import BaseLayout from './BaseLayout.astro';
import { formatDate, readingTime } from '../utils/date';
import { SITE } from '../site.config';

interface Props {
  title: string;
  date: string;
  description?: string;
  tags: string[];
  banner?: string;
  body?: string;
  backHref: string;
  backLabel: string;
}

const { title, date, description, tags, banner, body, backHref, backLabel } = Astro.props;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  image: banner ? new URL(banner, SITE.url).toString() : undefined,
  datePublished: date,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
  },
  keywords: tags.join(', ') || undefined,
};
---

<BaseLayout title={title} description={description} ogImage={banner}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <article>
    <header class="post-header stagger-item">
      <a href={backHref} class="back-link">← {backLabel}</a>
      {banner && (
        <img
          src={banner}
          alt={title}
          class="banner-img"
          width="1280"
          height="720"
          loading="lazy"
          decoding="async"
        />
      )}
      <h1>{title}</h1>
      <div class="post-meta">
        {date && <span class="badge primary">{formatDate(date)}</span>}
        {body && <span class="badge primary">{readingTime(body)}</span>}
        {tags.map(tag => <span class="badge secondary post-tag">{tag}</span>)}
      </div>
    </header>
    <div class="post-content stagger-item">
      <slot />
    </div>
  </article>
</BaseLayout>
