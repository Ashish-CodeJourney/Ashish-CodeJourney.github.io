---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Oneko from '../components/Oneko.astro';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource-variable/newsreader/wght-italic.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  voice?: 'tech' | 'notebook';
  chrome?: boolean;
}

const { title, description = SITE.description, ogImage, voice, chrome = true } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.author}` : `${SITE.author}, software engineer and open source contributor`;
const canonicalURL = new URL(Astro.url.pathname, SITE.url);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.author,
  url: SITE.url,
  description: SITE.description,
  author: {
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    sameAs: Object.values(SITE.socials),
  },
};
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="alternate" type="application/rss+xml" title={`${SITE.author}: all posts`} href="/rss.xml" />
  <meta name="theme-color" content="#0b1c26" />

  <script is:inline>
    document.documentElement.classList.add('js');
    document.addEventListener('astro:after-swap', () => document.documentElement.classList.add('js'));
  </script>
  <script>
    import theme from '../utils/theme.js';

    const stored = localStorage.getItem('theme');
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;

    theme.applyTheme(document.documentElement, theme.resolveTheme({ storedTheme: stored, prefersDark }));
  </script>

  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:type" content="website" />
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />

  <script defer is:inline src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "dd7ad3e3ae3643efaa8e648ff0a81477"}'></script>

  <slot name="head" />
  <ClientRouter />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  {chrome && <Header />}
  <main id="main" data-voice={voice}>
    <slot />
  </main>
  {chrome && <Footer />}
  {chrome && <Oneko />}
</body>
</html>
